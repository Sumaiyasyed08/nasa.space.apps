 if(m&&/(why|reject|accept|chosen|select|fail|rank)/.test(t)){const s=L(m[1].toUpperCase());if(!s)return`There is no Zone ${m[1].toUpperCase()} in this region.`;return s.ok?`Zone ${s.id} passes every mandatory constraint with a suitability of ${f(s.score)}/100${s===r?', and it ranks first, so it is the recommendation':', but it ranks below the recommendation'+(r?` (Zone ${r.id}, ${f(r.score)}/100)`:'')}. Slope ${f(s.slope95)}°, roughness ${f(s.rough,2)} m, ${s.rocks} boulders, ${f(s.shadowF*100,0)}% shadow, ${f(s.fuel,1)} kg divert fuel.`:`Zone ${s.id} was rejected because: ${s.viol.join('; ')}. Its weighted score was ${f(s.score)}/100, but mandatory constraints are applied before ranking, so a good score elsewhere cannot rescue it.`}
 if(/(fuel|propellant)/.test(t)){const c={...M,P:{...P,fuel_kg:Math.max(10,P.fuel_kg*.5)}};pickSites(c);return`Divert fuel is ${P.fuel_kg} kg now. If it were halved to ${f(c.P.fuel_kg,0)} kg, the reachable distance would drop to about ${f(c.P.fuel_kg/.08,0)} m from the nominal target. ${c.rec?`The best valid zone would then be at ${loc(c.rec.x,c.rec.y)} with suitability ${f(c.rec.score)}/100${r&&(c.rec.x!==r.x||c.rec.y!==r.y)?' (different from the current recommendation)':' (same as now)'}.`:'No zone would satisfy all constraints, so the result would be NO-GO.'} Estimates use 0.08 kg per metre (assumption).`}
 if(/(leg|footpad|pad |bearing|friction|slid|shock|vibrat|regolith)/.test(t)){const b=M.rec||M.sites[0],P=M.P;return`Touchdown model for Zone ${b.id}: normal impact speed ${f(b.vn,2)} m/s on this slope, crushed over a ${P.stroke} m stroke, with a dynamic load factor of ${P.dlf}. Worst leg carries ${f(b.Fleg,1)} kN (limit ${f(P.legAllow/P.sfDyn,1)} kN). Pad pressure is ${f(b.press,1)} kPa against ${f(P.bearing/P.sfDyn,1)} kPa of regolith bearing. Friction ${P.mu} gives a sliding safety factor of ${f(b.SFslide,1)}. Peak deceleration is ${f(b.aG,2)} g. These use your assumed soil, leg and lander values and are not measured data.`}
 if(/(payload|cargo|heavy|rover|habitat)/.test(t)){const P=M.P;return P.pMass>0?`Payload ${P.pMass} kg is on board. It raises divert fuel (scaled by total mass), moves the centre of mass (${f(M.sites[0].Htot,2)} m high, ${f(M.sites[0].eOff,2)} m sideways) which lowers the tip-over margin, and adds a tilt limit of ${P.pTilt}° for the payload itself. If total mass passes ${P.maxLandMass} kg, no site is safe. See the Payload verdict in Landing Zones.`:'No payload is entered yet. Add a payload mass in Constraints (or pick a preset) and ALLIS will check mass, centre of mass, tilt tolerance and fuel against every site.'}
 if(/(probab|p\(safe|p_safe|how safe|confiden|uncertain)/.test(t)){const b=M.rec||M.sites[0];return`P(safe touchdown) multiplies the chance that each measured value is really inside its limit: Φ((limit − measured)/σ) for slope, roughness, crater clearance and boulder height. Zone ${b.id}: slope ${f(b.pTerms.slope*100,1)}%, roughness ${f(b.pTerms.rough*100,1)}%, crater ${f(b.pTerms.crater*100,1)}%, boulder ${f(b.pTerms.boulder*100,1)}%, overall ${f(b.pSafe*100,1)}% against a ${f(M.P.pTarget*100,1)}% target. It assumes independent normal errors and your lander geometry guesses, so it is a model estimate, not a certified landing probability.`}
 if(/(slope|tilt|stab)/.test(t))return`Slope matters because a lander tips if one leg sits higher than the others. A steeper surface moves the centre of mass closer to the tipping edge and makes sliding more likely. In this region the mean slope is ${f(M.T.slope.reduce((a,b)=>a+b,0)/(N*N))}° and the current limit is ${P.maxSlope}° (95th percentile inside the footprint). ${M.vstat.slope} of ${M.totalEval} evaluated positions fail the slope limit.`;
 if(/(lowest|safest|least|minimum).*risk|lowest terrain|safest/.test(t)){const b=[...M.sites].map(s=>({s,k:(s.comp.slope+s.comp.rough+s.comp.crater+s.comp.obst+s.comp.area)/5})).sort((a,b)=>b.k-a.k)[0];return`By the five terrain-safety components (slope, roughness, crater clearance, obstacles, flat area), Zone ${b.s.id} is strongest with a terrain-safety average of ${f(b.k,0)}/100${b.s.ok?'':', but it is rejected on another constraint: '+b.s.viol.join('; ')}.`}
