function simOut(){const r=SIM.res,rows=[['conv','Conventional'],['allis','ALLIS-assisted']].filter(x=>r[x[0]]);if(!rows.length)return'';const R=(l,fn)=>`<tr><td>${l}</td>${rows.map(x=>`<td>${fn(r[x[0]])}</td>`).join('')}</tr>`;
 return`<h3>Result</h3><table class="tb cmp"><tr><th></th>${rows.map(x=>`<th>${x[1]}</th>`).join('')}</tr>${R('Landing site',q=>loc(q.x,q.y))}${R('Terrain risk index',q=>f(100-q.s.score,0)+' / 100')}${R('Suitability',q=>f(q.s.score))}${R('Divert fuel used',q=>f(q.fuel,1)+' kg')}${R('Distance from nominal',q=>f(q.s.div,0)+' m')}${R('Hazards in footprint',q=>q.s.rocks)}${R('Outcome',q=>q.s.ok?'<span class="ok">Meets all constraints</span>':'<span class="bad">UNSAFE: '+q.s.viol.join('; ')+'</span>')}</table>${rows.length<2?'<p class="note">Run the other approach to compare on the same start conditions.</p>':''}`}
