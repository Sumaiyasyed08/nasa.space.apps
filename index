 if(/(risk|danger|hazard|crater|biggest|worst)/.test(t)){const top=[...M.H].sort((a,b)=>b.risk-a.risk).slice(0,3),c=SEV.map((s,i)=>`${M.H.filter(h=>h.sev===i).length} ${s.toLowerCase()}`).join(', ');return`${M.H.length} hazards detected (${c}). The three largest risk contributors: ${top.map(h=>`${h.id} ${h.type.toLowerCase()} (${SEV[h.sev]}) at ${loc(h.x,h.y)}`).join('; ')}. ${top[0].why}`}
 if(/(improve|better|approach|increase|how can)/.test(t)){const vs=Object.entries(M.vstat).sort((a,b)=>b[1]-a[1])[0],nm={slope:'slope',rough:'surface roughness',crater:'crater proximity',rocks:'boulders',shadow:'shadowing',fuel:'divert fuel',psafe:'the probability-of-safe-touchdown target',tip:'tip-over margin',payload:'payload mass or tilt limits',legs:'landing-leg load',pad:'footpad bearing pressure',slide:'sliding on the slope',dyn:'sideways speed at touchdown'}[vs[0]];return`The most common reason positions fail here is ${nm} (${vs[1]} of ${M.totalEval} positions). ${vs[0]==='fuel'?'More divert fuel widens the search area.':'Choosing a region or landing time with less of this hazard helps more than relaxing a safety limit.'} Using the ALLIS-assisted approach also lets the lander retarget to the best valid zone${r?` (Zone ${r.id})`:''} instead of the nominal point.`}
